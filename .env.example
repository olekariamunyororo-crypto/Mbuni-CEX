# Mbuni CEX — environment template
# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` to git.

# Database
# Dev (SQLite — file path):
DATABASE_URL=file:./db/custom.db
# Production (PostgreSQL — connection string):
# DATABASE_URL=postgresql://user:password@localhost:5432/mbuni_cex?schema=public

# NextAuth — REQUIRED in production
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-strong-random-string-min-32-chars

# Public URL of the deployment (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# Mixpanel product analytics (optional — client no-ops when unset)
# Project token from Mixpanel → Project Settings → Project Token
NEXT_PUBLIC_MIXPANEL_TOKEN=
# EU data residency (default). Use https://api.mixpanel.com for US projects.
NEXT_PUBLIC_MIXPANEL_API_HOST=https://api-eu.mixpanel.com
# Set true to log track() calls in the browser console
NEXT_PUBLIC_MIXPANEL_DEBUG=false
